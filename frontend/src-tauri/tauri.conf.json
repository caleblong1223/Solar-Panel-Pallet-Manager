{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pallet Manager",
  "version": "2.0.0",
  "identifier": "com.crossroadssolar.palletmanager",
  "build": {
    "frontendDist": "../dist/web",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/prepare-bundled-backend.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pallet Manager 2.0",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../backend",
      "../../data"
    ]
  }
}
