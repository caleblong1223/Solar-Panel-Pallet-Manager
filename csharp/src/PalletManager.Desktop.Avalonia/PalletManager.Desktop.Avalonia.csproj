<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PalletManager.Application/PalletManager.Application.csproj" />
    <ProjectReference Include="../PalletManager.Domain/PalletManager.Domain.csproj" />
    <ProjectReference Include="../PalletManager.Infrastructure/PalletManager.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../PalletManager.Infrastructure/Persistence/Migrations/*.sql"
             Link="Persistence/Migrations/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
